# ==============================================================================
# ShikshaSetu Root Environment Configuration Template (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env (or backend/.env / frontend/.env) for local dev.
# 2. Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
APP_NAME=ShikshaSetu Backend
APP_ENV=development
DEBUG=true
PORT=8000
API_PREFIX=/api/v1

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=shikshasetu

# JWT Authentication
# In production (APP_ENV=production), JWT_SECRET / SECRET_KEY must be >= 16 characters
JWT_SECRET=change-this-development-secret-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI & LLM Services (Optional in local dev; defaults to mock)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding
EMBEDDING_DIMENSION=384
EMBEDDING_API_KEY=

# RAG & Document Processing
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_QUESTIONS_PER_GENERATION=5
GENERATION_RETRY_COUNT=3

# iGOT Karmayogi Integration
IGOT_INTEGRATION_MODE=prototype
IGOT_API_BASE_URL=
IGOT_CLIENT_ID=
IGOT_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1
