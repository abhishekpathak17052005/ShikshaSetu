APP_NAME=ShikshaSetu Backend
APP_ENV=development
DEBUG=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=shikshasetu
API_PREFIX=/api/v1
JWT_SECRET=change-this-development-secret-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Phase 6: AI & Document Processing

# LLM Provider: 'mock', 'openai', or 'gemini'
LLM_PROVIDER=mock
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Gemini: Get from https://aistudio.google.com/app/apikey
LLM_API_KEY=
LLM_MODEL=models/gemini-3.6-flash

# Embedding Provider: 'mock', 'openai', or 'gemini'
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=models/embedding-001
EMBEDDING_DIMENSION=768

# Document Processing
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_QUESTIONS_PER_GENERATION=5
GENERATION_RETRY_COUNT=3
