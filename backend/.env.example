# ShikshaSetu Backend Environment Configuration Template (.env.example)

APP_NAME=ShikshaSetu Backend
APP_ENV=development
DEBUG=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=shikshasetu
API_PREFIX=/api/v1
JWT_SECRET=change-this-development-secret-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI & LLM Provider Configuration (mock, openai, gemini)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding
EMBEDDING_DIMENSION=384
EMBEDDING_API_KEY=

# Document Processing & RAG Parameters
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_QUESTIONS_PER_GENERATION=5
GENERATION_RETRY_COUNT=3

# iGOT Karmayogi Integration
IGOT_INTEGRATION_MODE=prototype
IGOT_API_BASE_URL=
IGOT_CLIENT_ID=
IGOT_CLIENT_SECRET=
