        {
          "name": "provider",
          "type": "string",
          "required": false,
          "enum": ["IGOT", "NSSTA"]
        },
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "default": 10
        }
      ],
      "notes": "Browseable resources only",
      "tags": ["learning-resources"]
